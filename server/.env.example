# VoxDesk - Environment Variables
# Copy this file to .env and fill in your API keys.
# You only need keys for the providers whose models you actually select.


# ---- Use case (configurable) ----
# Which business profile the bot runs as. Drives the system prompt AND which
# eval scenarios apply (see business.py and evals/<BUSINESS>/). Options: store
BUSINESS=store

# Per-turn latency ladder: file for the JSONL log (Phase 4 scorecard). Set to
# "none" to disable file logging (console ladder still prints).
LATENCY_JSONL=metrics/turns.jsonl


# ---- Pipeline model defaults (client UI can override per session) ----
# Each maps to a row in the matching registry in bot.py. These are the defaults
# used when there's no UI selection (plain `uv run bot.py`, or evals).

# STT: deepgram (EN) | sarvam (Saaras saaras:v3, Hinglish/codemix)
STT_MODEL=deepgram

# LLM: gemini-3-flash | gemini-3.5-flash | gemini-3.1-flash-lite (fastest) |
#      gemini-flash-lite | gemini-2.5-flash |
#      gpt-5-mini | gpt-5-nano | sonnet-5 | sonnet-4.6
# Default is a Gemini model so the quickstart works on the free AI Studio key.
LLM_MODEL=gemini-3-flash

# TTS: cartesia (EN) | sarvam (Bulbul, Hinglish — uses the profile's tts_language)
TTS_MODEL=cartesia


# ---- Document search / RAG (search_docs tool) ----
# Policy/FAQ answers come from local docs, embedded and searched in an in-memory
# Qdrant. No API key either way. Only used when the active profile ships a
# data/<BUSINESS>/docs/ folder (store does); if embedding fails the bot still runs
# and search_docs just returns nothing.
#
# Embedding backend: ollama (default, best Hinglish) | fastembed | none
#   ollama    — bge-m3 via a local Ollama daemon. Best quality, but needs setup:
#               ollama pull bge-m3   (then keep `ollama serve` / the app running)
#   fastembed — in-process ONNX, no daemon, ~67 MB model downloaded on first use.
#               The zero-setup/CI path; weaker on Hinglish than bge-m3.
#   none      — no doc store at all; the bot runs with no document knowledge.
RAG_BACKEND=ollama

# Per-backend overrides (defaults shown). RAG_EMBED_MODEL is an Ollama tag and
# applies to RAG_BACKEND=ollama; RAG_FASTEMBED_MODEL is a Hugging Face repo id and
# applies to RAG_BACKEND=fastembed. Changing either means re-checking the score
# floor in rag.py: uv run python scripts/check_retrieval.py
# OLLAMA_BASE_URL=http://localhost:11434
# RAG_EMBED_MODEL=bge-m3
# RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5


# ---- API keys (fill in only what you use) ----

# Deepgram (STT) -> STT_MODEL=deepgram
DEEPGRAM_API_KEY=

# Cartesia (TTS) -> TTS_MODEL=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Sarvam (STT + TTS) -> STT_MODEL=sarvam and/or TTS_MODEL=sarvam
# Free credits at dashboard.sarvam.ai (no card).
SARVAM_API_KEY=
# Optional Sarvam overrides (defaults shown). bulbul:v2 was retired by Sarvam in
# Aug 2026 and v3 has a different voice roster (priya / shreya / neha / … —
# A/B them with scripts/generate_tts_preview.py):
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_VOICE=priya

# LLM provider keys — fill in the provider(s) whose models you'll use:
#   OPENAI_API_KEY    -> gpt-5-mini, gpt-5-nano
#   ANTHROPIC_API_KEY -> sonnet-5, sonnet-4.6
#   GOOGLE_API_KEY    -> gemini-3-flash, gemini-3.5-flash, gemini-3.1-flash-lite,
#                        gemini-flash-lite, gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
